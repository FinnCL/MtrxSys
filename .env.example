# ─────────────────────────────────────────────────────────────────────────────
# MtrxSys — variáveis de ambiente (DEV / localhost).
# Copie este arquivo para ".env" e ajuste. SEM .env o sistema já sobe com os
# defaults embutidos no docker-compose — o .env serve para sobrescrever segredos.
# NÃO comite o .env (ele está no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Postgres — senha do banco (usada pelo container postgres e pela connection string).
PG_PASS=mtrx

# JWT — chave que assina o token de login.
#   ⚠️ OBRIGATÓRIO ter NO MÍNIMO 32 caracteres.
#   Se for mais curta, a API E o Dispatcher MORREM no boot (ValidateOnStart) e
#   entram em crash-loop — sintoma no navegador: ERR_EMPTY_RESPONSE na porta da API.
#   Na dúvida, deixe esta linha comentada e use o default (>= 32 chars) do compose.
JWT_SIGNING_KEY=troque-por-uma-chave-aleatoria-de-32-ou-mais-caracteres

# WAHA (WhatsApp HTTP API)
WAHA_API_KEY=mtrxsys-dev-key
WAHA_DASH_USER=admin
WAHA_DASH_PASS=admin
WAHA_SWAGGER_USER=admin
WAHA_SWAGGER_PASS=admin
# Token opcional para validar o webhook do WAHA (vazio = desligado).
WAHA_HOOK_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Multi-ambiente (stacks 2..10): cada stack repete as MESMAS chaves com o número
# como sufixo — ex.: PG2_PASS, JWT2_SIGNING_KEY, WAHA2_API_KEY (e 3.., 4.., ...).
# O mesmo aviso do JWT vale para cada JWTn_SIGNING_KEY (mínimo 32 caracteres).
# Para rodar só 1 ambiente (o padrão), você não precisa dessas.
# ─────────────────────────────────────────────────────────────────────────────
