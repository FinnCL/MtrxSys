VITE_API_URL=http://localhost:5080

# Aba "Celular" — mesmas variáveis que a produção usa (aqui pra DEV ESPELHAR PROD).
# Vazias = sem tela de emulador embutida (aba mostra o QR/identidade do WAHA direto).
# Pra reproduzir a condição de produção no localhost (tela do emulador configurada), preencha:
#   VITE_EMULATOR_URL   → URL da tela embutível (maquete fake: http://localhost:3000; noVNC: :6080; ws-scrcpy: :8000)
#   VITE_EMULATOR_KIND  → "scrcpy" (stream do ws-scrcpy) ou vazio (embute a URL como está: noVNC/maquete)
#   VITE_PHONE_SERVER   → "1" mostra a seção "Configurar aparelho no servidor"
#   VITE_EMULATOR_UDID  → device adb a espelhar no modo scrcpy (ex.: 127.0.0.1:5555); vazio = emulator-5554
VITE_EMULATOR_URL=
VITE_EMULATOR_KIND=
VITE_PHONE_SERVER=
VITE_EMULATOR_UDID=
