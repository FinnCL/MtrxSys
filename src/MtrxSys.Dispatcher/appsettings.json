{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=mtrx;Username=mtrx;Password=mtrx"
  },
  "Waha": {
    "BaseUrl": "http://localhost:3000",
    "ApiKey": null,
    "TimeoutSeconds": 60
  },
  "Dispatch": {
    "SessionId": "default",
    "DelayMinSeconds": 60,
    "DelayMaxSeconds": 180,
    "TypingMinSeconds": 2,
    "TypingMaxSeconds": 5,
    "TypingJitter": 0.15,
    "OptOutFooter": "Para não receber mais mensagens, responda SAIR.",
    "PauseWhenSessionDown": true,
    "MaxSendAttempts": 2
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "OpenDurationMinutes": 120
  },
  "Warmup": {
    "Curve": [8, 11, 14, 18, 22, 28, 35, 44, 55, 68, 84, 104, 128, 158, 195, 240, 295, 355, 400, 400],
    "StartedOnUtc": "2026-05-24"
  },
  "HumanPhase": {
    "EffectiveFrom": null,
    "MinDays": 3,
    "MinPeople": 5,
    "MinInbound": 3,
    "MinOutbound": 3
  },
  "OptOut": {
    "PublicBaseUrl": ""
  }
}
