{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=mtrx;Username=mtrx;Password=mtrx"
  },
  "Waha": {
    "BaseUrl": "http://localhost:3000",
    "ApiKey": null,
    "TimeoutSeconds": 60
  },
  "Dispatch": {
    "SessionId": "default",
    "DelayMinSeconds": 60,
    "DelayMaxSeconds": 180,
    "TypingMinSeconds": 2,
    "TypingMaxSeconds": 5,
    "TypingJitter": 0.15,
    "OptOutFooter": "Para não receber mais mensagens, responda SAIR.",
    "PauseWhenSessionDown": true,
    "MaxSendAttempts": 2
  },
  "CircuitBreaker": {
    "FailureThreshold": 3,
    "OpenDurationMinutes": 120
  },
  "Warmup": {
    "Curve": [5, 8, 12, 12, 15, 15, 20, 20, 25, 25, 30, 35, 35, 45, 45, 55, 55, 70, 70, 85, 85, 100, 100, 120, 120, 150, 150, 180, 200],
    "StartedOnUtc": "2026-05-24"
  },
  "HumanPhase": {
    "EffectiveFrom": null,
    "MinDays": 3,
    "MinPeople": 5,
    "MinInbound": 3,
    "MinOutbound": 3
  },
  "OptOut": {
    "PublicBaseUrl": ""
  }
}
