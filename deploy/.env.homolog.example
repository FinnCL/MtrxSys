# Template das variáveis do ambiente de HOMOLOGAÇÃO. No SERVIDOR, copie pra deploy/.env.homolog e
# preencha os __TROQUE__ (o .env.homolog real é gitignored — nunca commite segredo).
# Gere segredos fortes:  openssl rand -hex 32
#
# Homolog é ISOLADO: DB/segredos/ledger próprios. Nunca reuse os valores de prod (.env.prod).

MTRX_DOMAIN=mtrxsys.com

# ── Postgres do homolog ──
PGH_PASS=__TROQUE__

# ── JWT (>= 32 chars) — distinto de prod (token de um ambiente não vale no outro) ──
JWTH_SIGNING_KEY=__TROQUE_32_CHARS_NO_MINIMO__

# ── WAHA real: api key + dashboard + swagger + token do webhook ──
WAHAH_API_KEY=__TROQUE__
WAHAH_HOOK_TOKEN=__TROQUE__
WAHAH_DASH_USER=admin
WAHAH_DASH_PASS=__TROQUE__
WAHAH_SWAGGER_USER=admin
WAHAH_SWAGGER_PASS=__TROQUE__

# ── Admin do painel de homolog ──
SEEDH_ADMIN_EMAIL=admin-hml@mtrxsys.com
SEEDH_ADMIN_PASS=__TROQUE__
SEEDH_ADMIN_NAME=Admin Homolog

# ── Opt-out público (link "sair" das mensagens) → subdomínio do homolog ──
OPTOUT_PUBLIC_URL_H=https://hml.mtrxsys.com

# ── Ledger SEMPRE Off no homolog (isolamento anti-ban). NÃO mude. ──
SHARED_LEDGER_MODE_H=Off

# ── Proxy do chip do homolog (opcional; vazio = sai pelo IP do host). host:porta, sem http:// ──
WAHA_PROXY_H=
WAHA_PROXY_H_USER=
WAHA_PROXY_H_PASS=

# ── Engine do WAHA (NOWEB padrão; WEBJS se precisar diagnosticar). Reparear o chip ao trocar. ──
WAHA_ENGINE=NOWEB

# ── Fase Humana (dias 1-3 de um chip novo) ─────────────────────────────────────────────────────
# Trava o DISPARO até você conversar à mão pela aba Chat; abre sozinha ao bater 5 conversas com
# ida-e-volta E 3 dias com atividade. Card na aba Celular. VAZIO = DESLIGADO (default).
# Homologação é o lugar certo pra experimentar: ponha a data de HOJE, pareie um chip e veja o
# gate travar e destravar. Em produção, use data >= a do deploy (ver .env.prod.example).
HUMAN_PHASE_FROM=
